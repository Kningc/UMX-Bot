# console: 在终端输入消息，适合本地开发
# qq-official: 连接 QQ 官方机器人
BOT_ADAPTER=console
BOT_COMMAND_PREFIX=/
BOT_DATABASE_PATH=./data/bot.sqlite
BOT_SHUTDOWN_TIMEOUT_MS=10000
# BOT_PLUGIN_MANIFEST=/absolute/path/plugins.json
LOG_LEVEL=info

# BOT_ADAPTER=qq-official 时必填
QQ_APP_ID=
QQ_CLIENT_SECRET=

# 默认只接收单聊和群内 @ 机器人的消息。
# 已在 QQ 开放平台获得全量群消息权限后可设为 true。
QQ_RECEIVE_ALL_GROUP_MESSAGES=false
QQ_REQUEST_TIMEOUT_MS=10000
QQ_GATEWAY_READY_TIMEOUT_MS=15000
QQ_RECONNECT_DELAY_MS=2000
QQ_RECONNECT_MAX_DELAY_MS=60000
