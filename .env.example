# console: 在终端输入消息，适合本地开发
# qq-official: 连接 QQ 官方机器人
BOT_ADAPTER=console
BOT_COMMAND_PREFIX=/
BOT_DATABASE_PATH=./data/bot.sqlite
BOT_SHUTDOWN_TIMEOUT_MS=10000
# 代码热重载次数上限（Node 无法释放已导入的模块，超出后需重启进程）。
# BOT_PLUGIN_MAX_HOT_RELOADS=20
# BOT_PLUGIN_MANIFEST=/absolute/path/plugins.json
# 健康快照路径，默认写到数据库同级目录的 health.json。
# BOT_HEALTH_FILE=./data/health.json
BOT_HEALTH_INTERVAL_MS=30000
# 以逗号分隔的用户 ID；匹配的人在对应会话里按 owner 处理。
# 匹配的是消息作者的 ID（`author.id`）。QQ 单聊取自 user_openid、群聊取自
# member_openid，是不同的字段，取值不一定相同；先让自己在每种会话里发一条命令，
# 再从命令审计日志（audit: "command"）的 authorId 字段里取值，把需要的都列上。
# BOT_OWNER_IDS=
# 可选的 HTTP 运维端点，提供 /healthz、/readyz 和 /metrics。默认关闭。
# BOT_METRICS_PORT=9095
# BOT_METRICS_HOST=127.0.0.1
LOG_LEVEL=info

# BOT_ADAPTER=qq-official 时必填
QQ_APP_ID=
QQ_CLIENT_SECRET=

QQ_API_BASE_URL=https://api.bot.qq.com
# 默认只接收单聊和群内 @ 机器人的消息。
# 已在 QQ 开放平台获得全量群消息权限后可设为 true。
QQ_RECEIVE_ALL_GROUP_MESSAGES=false
# 互动事件属于单独的 INTERACTION Intent，需要先获得权限再开启。
QQ_ENABLE_INTERACTIONS=false
# enterprise / personal / unverified，决定主动消息配额与限频档位。
QQ_CERTIFICATION=unverified
# 仅在确知机器人已获得对应 Intent 权限时才覆盖自动组合。
# QQ_INTENTS=
# 启动时根据插件导航声明幂等同步 QQ 单聊菜单和单聊/群聊指令面板。
QQ_SYNC_NAVIGATION=true
QQ_REQUEST_TIMEOUT_MS=10000
QQ_GATEWAY_READY_TIMEOUT_MS=15000
QQ_RECONNECT_DELAY_MS=2000
QQ_RECONNECT_MAX_DELAY_MS=60000
