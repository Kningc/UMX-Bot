{
  "name": "@qq-bot/core",
  "version": "0.6.0",
  "description": "Lifecycle, routing and plugin runtime for qq-bot",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kningc/UMX-Bot.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Kningc/UMX-Bot#readme",
  "bugs": {
    "url": "https://github.com/Kningc/UMX-Bot/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@qq-bot/plugin-sdk": "workspace:*",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/semver": "^7.7.1"
  }
}
