{
  "name": "@umx-bot/plugin-sdk",
  "version": "0.9.0",
  "description": "Platform-neutral plugin contracts for the UMX-Bot framework",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/*.js",
    "dist/*.js.map",
    "dist/*.d.ts",
    "dist/*.d.ts.map",
    "src/*.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kningc/UMX-Bot.git",
    "directory": "packages/plugin-sdk"
  },
  "homepage": "https://github.com/Kningc/UMX-Bot#readme",
  "bugs": {
    "url": "https://github.com/Kningc/UMX-Bot/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
