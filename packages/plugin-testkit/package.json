{
  "name": "@umx-bot/plugin-testkit",
  "version": "0.8.0",
  "description": "In-memory integration test host for UMX-Bot plugins",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "!dist/**/*.test.*",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@umx-bot/plugin-sdk": "^0.8.0"
  },
  "dependencies": {
    "@umx-bot/core": "workspace:*"
  },
  "devDependencies": {
    "@umx-bot/plugin-sdk": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kningc/UMX-Bot.git",
    "directory": "packages/plugin-testkit"
  },
  "homepage": "https://github.com/Kningc/UMX-Bot#readme",
  "bugs": {
    "url": "https://github.com/Kningc/UMX-Bot/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
