{
  "name": "qq-bot",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "changeset": "changeset",
    "check": "pnpm lint && pnpm build && pnpm -r --if-present typecheck && vitest run --coverage && pnpm verify:plugin-packages",
    "create:plugin": "node scripts/create-plugin.mjs",
    "deploy:menu": "sh deploy/sync-menu.sh",
    "deploy:production": "sh deploy/release.sh",
    "dev": "pnpm build && pnpm --filter @qq-bot/app dev",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "outbox": "node scripts/outbox.mjs",
    "release": "pnpm check && changeset publish",
    "start": "pnpm --filter @qq-bot/app start",
    "test": "pnpm build && vitest run",
    "test:coverage": "pnpm build && vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "pnpm build && pnpm -r --if-present typecheck",
    "validate:menu": "node scripts/sync-qq-menu.mjs deploy/qq-menu.json --validate-only",
    "verify:plugin-packages": "node scripts/verify-plugin-packages.mjs",
    "version-packages": "changeset version && pnpm install --lockfile-only"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
