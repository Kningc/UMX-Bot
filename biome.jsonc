{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.mjs",
      "**/*.json",
      "**/*.jsonc",
      "!**/dist",
      "!**/coverage",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "none",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": { "enabled": true },
    "parser": { "allowComments": true }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error",
        "noUnusedPrivateClassMembers": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": {
          "level": "error",
          "options": { "allow": ["error"] }
        },
        // `Awaitable<void | SentMessage>` 是插件 API 的刻意设计：实现者可以什么都
        // 不返回，也可以返回回执。换成 `SentMessage | undefined` 会让所有现有的
        // `async execute() { ... }`（推断为 Promise<void>）编译失败。
        "noConfusingVoidType": "off"
      },
      "style": {
        "useConst": "error",
        "useImportType": "error",
        "useExportType": "error",
        // tsconfig 已开启 noUncheckedIndexedAccess：长度检查之后的 `arr[0]!`
        // 是这个设置下的标准写法，这条规则会和它直接冲突。
        "noNonNullAssertion": "off"
      },
      "complexity": {
        "noForEach": "off"
      },
      "performance": {
        // tsconfig 已开启 exactOptionalPropertyTypes：删除可选属性只能用 delete，
        // 赋值 undefined 会直接报类型错误。
        "noDelete": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts"],
      "linter": {
        "rules": {
          "suspicious": { "noExplicitAny": "off" }
        }
      }
    },
    {
      "includes": [
        "scripts/**/*.mjs",
        "packages/*/src/smoke.ts",
        "packages/adapter-console/src/**/*.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": { "noConsole": "off" }
        }
      }
    }
  ]
}
