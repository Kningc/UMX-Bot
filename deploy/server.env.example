BOT_ADAPTER=qq-official
BOT_COMMAND_PREFIX=/
# 必须是绝对路径（发布脚本会校验）；把 /home/deploy 换成服务器上的实际目录。
BOT_DATABASE_PATH=/home/deploy/apps/qq-bot/shared/data/bot.sqlite
BOT_HEALTH_FILE=/home/deploy/apps/qq-bot/shared/data/health.json
BOT_HEALTH_INTERVAL_MS=30000
BOT_SHUTDOWN_TIMEOUT_MS=10000
# 以逗号分隔的用户 ID；匹配的人在对应会话里按 owner 处理。
# 匹配的是消息作者的 ID（`author.id`）。QQ 单聊取自 user_openid、群聊取自
# member_openid，是不同的字段，取值不一定相同；先让自己在每种会话里发一条命令，
# 再从命令审计日志（audit: "command"）的 authorId 字段里取值，把需要的都列上。
# BOT_OWNER_IDS=
# 运维 HTTP 端点（/healthz、/readyz、/metrics）。没有鉴权，只绑回环。
# BOT_METRICS_PORT=9095
# BOT_METRICS_HOST=127.0.0.1
# BOT_PLUGIN_MANIFEST=/home/deploy/apps/qq-bot/shared/plugins.json
LOG_LEVEL=info

QQ_APP_ID=
QQ_CLIENT_SECRET=
QQ_API_BASE_URL=https://api.bot.qq.com
QQ_RECEIVE_ALL_GROUP_MESSAGES=false
QQ_ENABLE_INTERACTIONS=false
QQ_CERTIFICATION=unverified
# Optional numeric override for the exact intents granted to this bot.
# QQ_INTENTS=
QQ_REQUEST_TIMEOUT_MS=10000
QQ_GATEWAY_READY_TIMEOUT_MS=15000
QQ_RECONNECT_DELAY_MS=2000
QQ_RECONNECT_MAX_DELAY_MS=60000
