{
  "schemaVersion": 1,
  "plugins": [
    {
      "specifier": "@qq-bot/plugin-help"
    },
    {
      "specifier": "@qq-bot/plugin-ping"
    },
    {
      "specifier": "@qq-bot/plugin-minecraft-status"
    },
    {
      "specifier": "@qq-bot/plugin-ai-agent",
      "enabled": false,
      "config": {
        "allowedGroupIds": ["GROUP_ID_1", "GROUP_ID_2"],
        "baseURL": "https://api.llm.ustc.edu.cn/v1",
        "model": "glm-5.2",
        "proxyUrl": "socks5h://127.0.0.1:1080",
        "dailyRequestLimitPerGroup": 0,
        "maxConcurrentRequests": 2
      },
      "secrets": {
        "apiKey": "AI_AGENT_API_KEY",
        "webSearchApiKey": "TAVILY_API_KEY"
      }
    }
  ]
}
