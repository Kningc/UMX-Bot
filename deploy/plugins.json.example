{
  "schemaVersion": 1,
  "plugins": [
    {
      "specifier": "@umx-bot/plugin-help"
    },
    {
      "specifier": "@umx-bot/plugin-ping"
    },
    {
      "specifier": "@umx-bot/plugin-minecraft-status"
    },
    {
      "specifier": "/home/deploy/apps/qbot-agent/current/dist/index.js",
      "enabled": false,
      "config": {
        "allowedGroupIds": ["GROUP_ID_1", "GROUP_ID_2"],
        "baseURL": "https://api.deepseek.com/v1",
        "model": "deepseek-flash",
        "spontaneousModel": "deepseek-flash"
      },
      "secrets": {
        "apiKey": "DEEPSEEK_API_KEY",
        "webSearchApiKey": "TAVILY_API_KEY"
      }
    }
  ]
}
